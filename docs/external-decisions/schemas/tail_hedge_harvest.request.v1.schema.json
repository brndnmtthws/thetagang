      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "request_id",
    "decision_type",
    "generated_at",
    "dry_run",
    "input"
