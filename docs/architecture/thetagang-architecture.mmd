flowchart TB
    subgraph ANALYSIS["候选标的分析 · 只读 / 仅生成建议"]
        CANDIDATES["候选标的输入<br/>JSON / --symbols<br/>交易员限定范围"]
        PROVIDER["CandidateDataProvider<br/>人工 / 智能体结构化数据<br/>只读 IBKRCandidateDataProvider"]
        SNAPSHOT["候选观察快照<br/>价差 · 成交量 · OI · DTE<br/>IV / RV · 财报状态 · 风险组"]
        SCREEN["硬过滤与可解释评分<br/>流动性 · DTE · 事件窗口<br/>收益与风险分项 · 淘汰原因"]
        ALLOCATOR["压力模拟与约束分配<br/>压力损失 · 单张合约规模<br/>单标的 / 风险组上限"]
        REPORT["推荐结果<br/>Markdown 审核报告<br/>JSON 证据 · TOML 权重片段"]
        CANDIDATES --> PROVIDER --> SNAPSHOT --> SCREEN --> ALLOCATOR --> REPORT
    end

    EVENT["可选事件数据源<br/>财报日历 · 分红日<br/>缺失时标记未验证"]
    READONLY["只读分析数据<br/>目标 DTE 近 ATM Put / Call<br/>行情 · OI · 成交量 · Greeks · 日线"]
    EVENT -.-> SNAPSHOT
    READONLY -.-> PROVIDER

    CLI["交易命令行入口<br/>entry.py → main.py"]
    CFG["正式 TOML 配置<br/>config_migration<br/>config / config_models"]
    REPORT -.->|交易员审核后复制权重| CFG

    subgraph APP["ThetaGang · 交易运行"]
        START["启动与恢复 · thetagang.py<br/>账户锁 · 交易时段<br/>历史提交及券商对账 · 断线退出"]
        PM["PortfolioManager<br/>实际持仓 + 工作挂单 + 本轮意图<br/>按 run 配置顺序调度阶段"]
        subgraph STRATEGIES["策略层 · Wheel 与 Regime 互斥"]
            OPT["OptionsStrategyEngine<br/>卖 Put / Call · 展期 · 平仓"]
            EQ["Equity / Regime<br/>股票再平衡 · 状态门控 · 动态权重"]
            POST["PostStrategyEngine<br/>VIX Call 对冲 · 现金管理"]
        end
        QUEUE["OrderOperations → Orders → BatchRisk<br/>订单意图 · 跨策略预留<br/>去重 · 敞口 · 支出 · 保证金"]
        PREVIEW["dry-run<br/>只输出订单摘要"]
        EXEC["Trades · 提交与跟踪<br/>先落盘再提交 · 调价再校验<br/>失败与未知结果向上返回"]
        START --> PM
        PM --> OPT
        PM --> EQ
        PM --> POST
        OPT --> QUEUE
        EQ --> QUEUE
        POST --> QUEUE
        QUEUE -->|dry-run| PREVIEW
        QUEUE -->|实盘通过| EXEC
    end

    SCAN["OptionChainScanner<br/>DTE · Delta · 价格<br/>供交易策略选择合约"]
    ADAPTER["IBKR 适配层 · ibkr.py<br/>账户 / 持仓 / 行情 / 日线<br/>合约验证 · what-if · 交易写操作"]
    GW["TWS / IB Gateway<br/>分析命令要求已运行<br/>交易可由 IBC / Watchdog 管理"]
    IB["Interactive Brokers<br/>账户 · 市场数据 · 交易执行"]
    STORE["持久化与恢复<br/>ExecutionJournal · 原子 JSON<br/>DataStore · SQLite（可选）<br/>运行 · 快照 · 意图 · 状态 · 成交"]
    AUDIT["审计与说明<br/>架构 / 策略 / 修订记录<br/>候选分析报告留痕"]
    DASHBOARD["本地中文交易仪表盘<br/>dashboard.py · 127.0.0.1<br/>历史 / 订单 / 持仓 / 决策 / 导出"]
    DECISIONS["策略决策留痕<br/>Put / Call 门槛与数量<br/>VIX 预算 / 现金管理原因"]
    STRATEGIES -.-> DECISIONS --> STORE
    STORE -->|SQLite 只读事务| DASHBOARD
    DASHBOARD -.-> AUDIT

    CLI --> START
    CFG --> START
    STRATEGIES -.-> SCAN --> ADAPTER
    PM <-->|账户与持仓| ADAPTER
    EXEC -->|提交 / 修改订单| ADAPTER
    START -.-> STORE
    PM -.-> STORE
    EXEC -->|提交前先落盘| STORE
    ANALYSIS -.-> AUDIT
    APP -.-> AUDIT
    PROVIDER -.-> ADAPTER
    ADAPTER <-->|ib_async| GW
    GW <--> IB
    READONLY -.-> GW
