flowchart TB
    INIT["账户与持仓 / 工作挂单 / 配置"] --> MODE{"run 配置选择"}
    NOTE["run.strategies 按规范顺序展开<br/>run.stages 保留显式顺序<br/>Call 要求 Put 被启用；顺序仍需 depends_on"] -.-> MODE

    subgraph W["路线 A · Wheel"]
      WT["资金 B = NLV × wheel margin<br/>目标股数 / 股票数 / 空头合约数"]
      ENTRY["先卖 Put 规划 → 再卖 Call 规划<br/>Put 受买入股票模式抑制；Call 受卖出模式抑制"]
      SCAN["方向 / 价格变动 / 数量 / 合约扫描<br/>DTE 下限；Delta 优选可回退超限<br/>新增张数分批限制至少为 1 张"]
      EQUITY["股票补仓 / 减仓<br/>off / buy_only / sell_only / both"]
      MANAGE["检查已有空头期权（排除 VIX）<br/>先判可展期，失败才检查 close_at_pnl"]
      ROLL["展期：BUY 旧 + SELL 新<br/>同到期不同执行价也允许"]
      CLOSE["平仓：BUY 买回空头<br/>可展期者即使超过止盈线也不会归此类"]
      WT --> ENTRY --> SCAN --> EQUITY --> MANAGE
      MANAGE -->|"可展期且阶段启用"| ROLL
      MANAGE -->|"不可展期且 P&L 大于止盈线"| CLOSE
    end
    subgraph R["路线 B · Regime 股票再平衡"]
      RB["资金基准<br/>net_liq / net_liq_ex_options / managed_stocks"]
      RW["基础权重 → 波动率调整 / 平滑 / 限幅<br/>有效权重直接乘资金基准，不归一到 100%"]
      RD["相对偏离 + 历史代理组合<br/>市场状态 / 冷却期 / 可选 ratio gate"]
      HARD{"Hard 触发？"}
      SOFT{"Soft 触发且软门控通过？"}
      DEF{"Deficit 达启动或持续阈值？"}
      FLOW{"Flow 阈值 + 软门控<br/>股数缺口方向一致性通过？"}
      RO["股票订单<br/>Hard 可部分回归；Hard/Soft 可追加缺口清理<br/>所有模式仍受方向、交易允许与最小阈值限制"]
      HOLD["保持 / 无订单"]
      RB --> RW --> RD --> HARD
      HARD -->|是| RO
      HARD -->|否| SOFT
      SOFT -->|是| RO
      SOFT -->|否| DEF
      DEF -->|是| RO
      DEF -->|否| FLOW
      FLOW -->|是| RO
      FLOW -->|否| HOLD
    end
    MODE -->|"选择 Wheel"| WT
    MODE -->|"选择 Regime，二者互斥"| RB
    ROLL --> POST
    CLOSE --> POST
    MANAGE -->|无动作| POST
    RO --> POST
    HOLD --> POST
    MODE -->|"只选后置阶段也可"| POST

    POST{"VIX 阶段被选中且 enabled=true？"}
    POST -->|是| VQ{"已有净多 VIX Call？"}
    POST -->|否| CASH
    VQ -->|是| VC{"现货 VIX 严格超过平仓线？"}
    VC -->|否：持有| CASH
    VC -->|"是：当前实现有持仓筛选缺口"| VS["生成 SELL 意图<br/>不是仅多头 Call；详见复核报告"]
    VQ -->|"否：净数量小于等于 0"| VN{"现货 VIX 超过平仓线？"}
    VN -->|是：不新买| CASH
    VN -->|否| VB["读取 VIXMO / 计算 NLV 预算 / 买 Call<br/>默认分档越界：VIXMO≥15 实际命中 1%"]
    VS --> CASH
    VB --> CASH
    CASH{"现金阶段被选中且 enabled=true？"}
    CASH -->|是| CB["有效现金 = TotalCash − 待发生支出<br/>可扫现金 = 有效现金 − Regime 预留"]
    CB --> CG{"可扫现金高于买阈值<br/>或有效现金低于卖阈值？"}
    CG -->|是| CF["买 / 卖现金基金"]
    CG -->|否| Q
    CF --> Q
    CASH -->|否| Q["本轮订单队列"]
    Q --> RISK["统一批次检查 / 实盘 what-if<br/>不能替代 Delta、VIX 档位和 no_trading 语义校验"]
    RISK -->|模拟| DRY["输出本地订单预览"]
    RISK -->|实盘通过| EXEC["先写恢复日志 → 提交 → 调价 → 记录结果"]
    RO -.->|"仅 Flow 产生买单后预留剩余正现金"| CB
    SAMPLE["仓库示例：Wheel 阶段已选<br/>VIX 与现金阶段已选但 enabled=false<br/>Regime 未选"] -.-> MODE
    classDef wheel fill:#fff3df,stroke:#c58a2b,color:#3f310e
    classDef regime fill:#f1ecfa,stroke:#8467a6,color:#35234e
    classDef post fill:#e8f6ee,stroke:#4e9870,color:#173b26
    class WT,ENTRY,SCAN,EQUITY,MANAGE,ROLL,CLOSE wheel
    class RB,RW,RD,HARD,SOFT,DEF,FLOW,RO,HOLD regime
    class POST,VQ,VC,VS,VN,VB,CASH,CB,CG,CF post
